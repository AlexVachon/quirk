# Compiler settings
#
# `llvm-config-14` is the apt naming used on Debian/Ubuntu. Homebrew's
# `llvm@14` formula installs it under `/opt/homebrew/opt/llvm@14/bin`
# (Apple Silicon) or `/usr/local/opt/llvm@14/bin` (Intel) — pre-seed
# LLVM_CONFIG=/opt/homebrew/opt/llvm@14/bin/llvm-config when building
# on macOS. The compiler/runtime themselves are POSIX-clean; nothing
# else in the Makefile needs an OS branch.
LLVM_CONFIG ?= llvm-config-14

# -O2 on the host C++ build: this is the Quirk compiler itself, not the
# LLVM passes it runs over user IR. Default-O0 means parser/sema/codegen
# walk the AST unoptimized, which added ~30-40% to every invocation.
CXX      ?= g++
CXXFLAGS = -std=c++17 -Wall -O2 -Iinclude $(shell $(LLVM_CONFIG) --cppflags) -MMD -MP
LDFLAGS  = $(shell $(LLVM_CONFIG) --ldflags --libs all --system-libs) -lpthread

# Same story for runtime.so — the .c files implementing String, List, Map,
# etc. were unoptimized at runtime. -O2 here makes every string/list/map
# operation faster.
CC     ?= gcc
# `-shared -fPIC` is the same incantation on Linux and macOS. Apple's
# clang accepts `-shared` and produces a `.dylib`-compatible Mach-O
# object; keeping the `.so` filename is fine because `dlopen` ignores
# the extension on macOS. (Renaming to `.dylib` would also work but
# would ripple into 7+ install-script and resolver sites for no
# practical benefit.)
CFLAGS = -shared -fPIC -O2

# Directories
SRC_DIR = src
OBJ_DIR = obj
BIN_DIR = bin

# --- 1. COMPILER SOURCES ---
SRCS = src/Compiler.cpp src/Core/Lexer.cpp src/Core/Parser.cpp src/Core/Sema.cpp
OBJS = $(patsubst $(SRC_DIR)/%.cpp, $(OBJ_DIR)/%.o, $(SRCS))
DEPS = $(OBJS:.o=.d)

# linenoise — vendored single-file readline alternative for the REPL.
# BSD-2-clause (see src/third_party/linenoise/LICENSE). Built as a C
# translation unit and linked in alongside the C++ compiler objects.
LINENOISE_SRC = src/third_party/linenoise/linenoise.c
LINENOISE_OBJ = $(OBJ_DIR)/third_party/linenoise/linenoise.o

# The C++ compiler is the production binary. `bin/quirk-cpp` is
# the primary name; `bin/quirk` is installed as a symlink so
# `#!/usr/bin/env quirk` shebangs and habit-typing work. The
# self-hosted Quirk-in-Quirk compiler lives in its own repo at
# github.com/AlexVachon/quirk-selfhost since v5.2.0.
TARGET = $(BIN_DIR)/quirk-cpp
DRIVER = $(BIN_DIR)/quirk

# --- 2. RUNTIME LIBRARY ---
# Entry point (unity build — includes all .c files below)
RUNTIME_ENTRY = src/Runtime/runtime.c

# All C files pulled in via #include; any change here rebuilds runtime.so
# Every file the unity build (runtime.c) pulls in — a wildcard, so a new
# runtime file can't be forgotten here (core/callable.c and core/task.c
# were missing, and editing them didn't rebuild runtime.so).
RUNTIME_DEPS  = $(wildcard src/Runtime/*.h src/Runtime/core/*.c src/Runtime/libs/*.c src/Runtime/libs/*/*.c)

RUNTIME_LIB = $(BIN_DIR)/runtime.so

# --- RULES ---

all: $(TARGET) $(RUNTIME_LIB) $(DRIVER)

$(TARGET): $(OBJS) $(LINENOISE_OBJ)
	@mkdir -p $(BIN_DIR)
	$(CXX) $(OBJS) $(LINENOISE_OBJ) -o $@ $(LDFLAGS)

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(LINENOISE_OBJ): $(LINENOISE_SRC) src/third_party/linenoise/linenoise.h
	@mkdir -p $(dir $@)
	$(CC) -O2 -fPIC -c $< -o $@

$(RUNTIME_LIB): $(RUNTIME_ENTRY) $(RUNTIME_DEPS)
	@mkdir -p $(BIN_DIR)
	@echo "Compiling Runtime Library..."
	$(CC) $(CFLAGS) $(RUNTIME_ENTRY) -o $@ -lgc -lssl -lcrypto -lpthread

# Include compiler dependency files (auto-generated by -MMD)
-include $(DEPS)

clean:
	rm -rf $(OBJ_DIR)
	rm -f $(TARGET) $(RUNTIME_LIB)

# Quick smoke: compile and run a test file
test: all
	./$(TARGET) tests/encoding_test.quirk

# --- DRIVER SHIM ------------------------------------------------------------
# The `bin/quirk` shim — a symlink to `bin/quirk-cpp`. Historically
# this was a shell driver that dispatched to the selfhost binary
# with fallback to quirk-cpp; since v5.2.0 the selfhost lives in
# its own repo (github.com/AlexVachon/quirk-selfhost), so `bin/quirk`
# is just the C++ compiler under a friendlier name.
$(DRIVER): $(TARGET)
	@mkdir -p $(BIN_DIR)
	@ln -sf quirk-cpp $@
	@echo "  installed: $@ → quirk-cpp"

# --- STDLIB BOOTSTRAP -------------------------------------------------------
# Fetch the 21 canonical stdlib repos into ./packages/. Required for:
#   - fresh contributor checkouts (the source tree no longer ships bundled
#     stdlib)
#   - the release workflow (the resulting tarball needs a populated
#     packages/ dir so install.sh users get a working compiler)
#
# Idempotent: skips any package whose subdir already has an `index.quirk`.
# Versioned: each clone pins the package's `v1.0.0` tag (matching the
# stdlib_registry() versions baked into the compiler). To pull newer tags,
# bump the version inline below and re-run.
STDLIB_PACKAGES = \
	argparse console crypto csv datetime debug encoding fs html io itertools \
	math net process prompt random regex statistics sys test time toml typing url uuid
STDLIB_OWNER ?= AlexVachon
STDLIB_TAG   ?= v1.0.0

# Per-package tag override. Set when a package has its own version
# that doesn't match the global STDLIB_TAG (e.g. `prompt` was
# renamed from `ask` and ships v1.0.1 with the rename baked in).
STDLIB_TAG_prompt ?= v1.1.0
# typing v1.15.1 adds the collections (Map/List/Set/Queue/Tuple +
# their iterators) to `typing.prelude` — v1.15.0 shipped the prelude
# with only primitives + interfaces + Callable, which failed the
# compiler's export-check on the very natural `from typing.prelude
# use { Map, List }` shape. v1.15.2 documents Int as 64-bit (v7.0.0).
# v1.16.0: List.sort's comparator is optional (native sort, v7.9.0).
# v1.16.1: ljust / rjust / center pad with a space by default (v7.9.1).
# v1.16.2: Exception.print_traceback() writes to stderr (v7.11.1).
# v1.17.0: CancelledError, for task.cancel() (v7.13.0).
STDLIB_TAG_typing ?= v1.17.0
# html v1.0.0 is the initial release (compiler v3.5.0+). The
# explicit pin keeps a global STDLIB_TAG bump from accidentally
# pulling a v2 with potentially breaking changes.
STDLIB_TAG_html ?= v1.0.1
# net v1.2.0 adds Response.json() convenience method on top of
# v1.1.0's TLS support. Earlier v1.1.0 baseline still requires the
# v3.7.0+ runtime (Net_tls_* C symbols + -lssl); .json() is a
# pure-Quirk one-liner so v1.2.0 has no additional compiler
# requirement beyond what v1.1.0 already needed.
# net v1.3.0: the HTTP server handles each connection as a task (v7.12.0).
STDLIB_TAG_net ?= v1.3.0
# test v1.1.0 documents `quirk test`'s `define test_*()` discovery (v7.10.0).
STDLIB_TAG_test ?= v1.1.0
# fs v1.1.0 adds remove_tree (runtime Fs_remove_tree_raw, v7.11.1).
# fs v1.2.0: walk, glob, temp files, copy, read/write_text (runtime v7.19.0).
STDLIB_TAG_fs ?= v1.2.0
# process v1.0.0 is the initial release; v1.0.1 requires compiler 7.18.0 (runtime Process_*).
STDLIB_TAG_process ?= v1.0.1

# --- INSTALL / UNINSTALL --------------------------------------------------
# Copy the freshly-built compiler + runtime into $(PREFIX) (default
# ~/.quirk/bin). `bin/quirk` is installed as a regular file rather
# than a symlink so it works after copying to a different filesystem
# or a permission-restricted user dir. Runs `all` first so an
# out-of-date build gets caught.
PREFIX ?= $(HOME)/.quirk

install: all
	@mkdir -p $(PREFIX)/bin
	@cp -f $(TARGET) $(PREFIX)/bin/quirk-cpp
	@cp -f $(TARGET) $(PREFIX)/bin/quirk
	@cp -f $(RUNTIME_LIB) $(PREFIX)/bin/runtime.so
	@chmod +x $(PREFIX)/bin/quirk $(PREFIX)/bin/quirk-cpp
	@echo ""
	@echo "  installed to $(PREFIX)/bin:"
	@echo "    quirk        ($$(stat -c%s $(PREFIX)/bin/quirk) bytes)"
	@echo "    quirk-cpp    ($$(stat -c%s $(PREFIX)/bin/quirk-cpp) bytes)"
	@echo "    runtime.so   ($$(stat -c%s $(PREFIX)/bin/runtime.so) bytes)"
	@echo ""
	@echo "  run: $(PREFIX)/bin/quirk --version"

uninstall:
	@rm -f $(PREFIX)/bin/quirk $(PREFIX)/bin/quirk-cpp $(PREFIX)/bin/runtime.so
	@echo "  removed compiler binaries from $(PREFIX)/bin"

bootstrap-stdlib:
	@mkdir -p packages
	@for pkg in $(STDLIB_PACKAGES); do                                            \
	    tag="$(STDLIB_TAG)";                                                      \
	    case "$$pkg" in                                                           \
	        prompt) tag="$(STDLIB_TAG_prompt)" ;;                                 \
	        typing) tag="$(STDLIB_TAG_typing)" ;;                                 \
	        html)   tag="$(STDLIB_TAG_html)"   ;;                                 \
	        net)    tag="$(STDLIB_TAG_net)"    ;;                                 \
	        test)   tag="$(STDLIB_TAG_test)"   ;;                                 \
	        fs)     tag="$(STDLIB_TAG_fs)"     ;;                                 \
	        process) tag="$(STDLIB_TAG_process)" ;;                               \
	    esac;                                                                     \
	    if [ -f "packages/$$pkg/index.quirk" ] &&                                 \
	       [ "$$(cat packages/$$pkg/.version 2>/dev/null)" = "$$tag" ]; then      \
	        echo "  ✓ $$pkg@$$tag (already present)";                             \
	        continue;                                                             \
	    fi;                                                                       \
	    echo "  → cloning quirk-$$pkg@$$tag";                                     \
	    tmp=$$(mktemp -d);                                                        \
	    if ! git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$$tag" \
	            "https://github.com/$(STDLIB_OWNER)/quirk-$$pkg.git" "$$tmp";     \
	    then                                                                      \
	        echo "  ✗ $$pkg — clone failed";                                      \
	        rm -rf "$$tmp";                                                       \
	        exit 1;                                                               \
	    fi;                                                                       \
	    rm -rf "packages/$$pkg";                                                  \
	    if [ -d "$$tmp/src" ]; then                                               \
	        mv "$$tmp/src" "packages/$$pkg";                                      \
	    else                                                                      \
	        mv "$$tmp" "packages/$$pkg";                                          \
	    fi;                                                                       \
	    echo "$$tag" > "packages/$$pkg/.version";                                 \
	    rm -rf "$$tmp";                                                           \
	done
	@echo "Stdlib bootstrap complete: $$(ls packages | wc -l) packages"

# Per-package release assets: `stdlib-<name>-<ver>.tar.gz` for each
# bootstrapped package plus `stdlib.lock` (`<name> <tag> <bytes> <sha256>`),
# which `quirk compiler update` downloads one by one (7.3.0+). Run after
# bootstrap-stdlib; the release workflow uploads them. Only these files
# are replaced, so the dir can also hold the compiler tarball.
STDLIB_ASSETS ?= stdlib-assets
stdlib-assets:
	@mkdir -p "$(STDLIB_ASSETS)" && rm -f "$(STDLIB_ASSETS)"/stdlib-*.tar.gz "$(STDLIB_ASSETS)/stdlib.lock"
	@echo "# <name> <tag> <bytes> <sha256>" > "$(STDLIB_ASSETS)/stdlib.lock"
	@for d in packages/*/; do                                                     \
	    n=$$(basename "$$d"); v=$$(cat "$$d/.version" 2>/dev/null);               \
	    if [ -z "$$v" ]; then echo "  ✗ $$n has no .version — run bootstrap-stdlib"; exit 1; fi; \
	    f="$(STDLIB_ASSETS)/stdlib-$$n-$${v#v}.tar.gz";                           \
	    tar czf "$$f" -C packages "$$n";                                          \
	    sum=$$( (sha256sum "$$f" 2>/dev/null || shasum -a 256 "$$f") | cut -c1-64); \
	    echo "$$n $$v $$(wc -c < "$$f" | tr -d ' ') $$sum" >> "$(STDLIB_ASSETS)/stdlib.lock"; \
	done
	@echo "stdlib assets: $$(ls $(STDLIB_ASSETS)/stdlib-*.tar.gz | wc -l | tr -d ' ') packages → $(STDLIB_ASSETS)/"

# Convenience: wipe + re-fetch the entire stdlib.
bootstrap-stdlib-clean:
	rm -rf packages
	$(MAKE) bootstrap-stdlib

# Regenerate `docs/stdlib/*.md` from the in-source `---` docstrings
# in `packages/*/*.quirk`. Run after touching any stdlib docstring or
# refreshing the bootstrap. Requires Python 3.
docs:
	@python3 tools/gen_stdlib_docs.py

# Mutation-based compiler fuzzer (tools/fuzz.py). Picks random files
# from tests/probes + tests/, mutates them (operator/literal/type
# swaps, line drops/dups/swaps), runs the result, and saves any
# crash (SIGSEGV / ICE / malformed IR) under tools/fuzz_findings/.
# Use after touching Sema or Codegen — surfaces the next class of
# input the compiler can't handle gracefully.
#
#   make fuzz                                  # 500 iters
#   make fuzz FUZZ_ITERS=2000 FUZZ_SEED=42      # reproducible
FUZZ_ITERS ?= 500
FUZZ_SEED  ?=
fuzz:
	@python3 tools/fuzz.py --iters $(FUZZ_ITERS) $(if $(FUZZ_SEED),--seed $(FUZZ_SEED),) --quiet

.PHONY: all clean test install uninstall bootstrap-stdlib bootstrap-stdlib-clean stdlib-assets docs fuzz
