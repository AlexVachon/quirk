// argparse: tests the help/usage construction and flag-helper logic. Full
// argv parsing is exercised separately through the smoke scripts (see the
// repo's docs) since `parse()` reads sys.argv() and exits on errors —
// awkward to assert against in-process.
use argparse
use test

// The parser the tests inspect.
define widget_parser() {
    p := argparse.parser("widget", "make widgets")
    p.positional("input", "input file")
    p.option("name", "n", "anon", "widget name")
    p.flag("verbose", "v", "log everything")
    p.required("output", "o", "output file")
    return p
}

// specs are added in order
define test_specs_are_added_in_order() -> void {
    p := widget_parser()
    // 4 declared specs (positional, option, flag, required)
    test.assert_eq(p.specs.length(), 4)
}

// flag() helper recognizes 'true'
define test_flag_helper_recognizes_true() -> void {
    m := Map()
    m.put("verbose", "true")
    test.assert_true(argparse.flag(m, "verbose"))
}

// flag() helper recognizes 'false'
define test_flag_helper_recognizes_false() -> void {
    m := Map()
    m.put("verbose", "false")
    test.assert_false(argparse.flag(m, "verbose"))
}

// _find_long resolves declared spec
define test_find_long_resolves_declared_spec() -> void {
    p := widget_parser()
    s := p._find_long("name")
    test.assert_eq(s.name, "name")
    test.assert_eq(s.short, "n")
}

// _find_long returns null for unknown
define test_find_long_returns_null_for_unknown() -> void {
    p := widget_parser()
    test.assert_eq(p._find_long("xyz"), null)
}

// _find_short resolves declared spec
define test_find_short_resolves_declared_spec() -> void {
    p := widget_parser()
    s := p._find_short("o")
    test.assert_eq(s.name, "output")
    test.assert_true(s.required)
}

// flags carry default 'false'
define test_flags_carry_default_false() -> void {
    p := widget_parser()
    s := p._find_long("verbose")
    test.assert_eq(s.default_str, "false")
    test.assert_true(s.is_flag)
}

// required option has empty default and required=true
define test_required_option_has_empty_default_and() -> void {
    p := widget_parser()
    s := p._find_long("output")
    test.assert_true(s.required)
    test.assert_eq(s.default_str, "")
}

// positional has is_positional=true
define test_positional_has_is_positional_true() -> void {
    p := widget_parser()
    s := p._find_long("input")
    test.assert_true(s.is_positional)
    test.assert_true(s.required)
}

