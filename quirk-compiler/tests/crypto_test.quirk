// crypto library test — uses the `test` runner for a structured pass/fail
// report. Reference digest values are from RFC test vectors and well-known
// implementations.
use crypto
use test

// Hash reference values for the input "hello".
md5_hello := "5d41402abc4b2a76b9719d911017c592"
sha1_hello := "aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d"
sha256_hello := "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"

// md5('hello')
define test_md5_hello() -> void {
    test.assert_eq(crypto.md5("hello"), md5_hello)
}

// sha1('hello')
define test_sha1_hello() -> void {
    test.assert_eq(crypto.sha1("hello"), sha1_hello)
}

// sha256('hello')
define test_sha256_hello() -> void {
    test.assert_eq(crypto.sha256("hello"), sha256_hello)
}

// sha256('') is the empty-string hash
define test_sha256_is_the_empty_string_hash() -> void {
    test.assert_eq(
    crypto.sha256(""),
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    )
}

// sha512 produces 128 hex chars
define test_sha512_produces_128_hex_chars() -> void {
    test.assert_eq(crypto.sha512("hello").length(), 128)
}

// HMAC-SHA256 reference: HMAC("key", "msg") = ...
// hmac_sha256 deterministic
define test_hmac_sha256_deterministic() -> void {
    test.assert_eq(
    crypto.hmac_sha256("key", "msg"),
    "2d93cbc1be167bcb1637a4a23cbff01a7878f0c50ee833954ea5221bb1b8c628"
    )
}

// hmac changes with the key
define test_hmac_changes_with_the_key() -> void {
    a := crypto.hmac_sha256("k1", "msg")
    b := crypto.hmac_sha256("k2", "msg")
    test.assert_ne(a, b)
}

// random_hex returns 2n chars
define test_random_hex_returns_2n_chars() -> void {
    test.assert_eq(crypto.random_hex(16).length(), 32)
    test.assert_eq(crypto.random_hex(32).length(), 64)
}

// random_hex differs across calls
define test_random_hex_differs_across_calls() -> void {
    a := crypto.random_hex(16)
    b := crypto.random_hex(16)
    test.assert_ne(a, b)
}

// uuid is 36 chars
define test_uuid_is_36_chars() -> void {
    test.assert_eq(crypto.uuid().length(), 36)
}

// uuid v4 marker is '4' at index 14
define test_uuid_v4_marker_is_4_at_index_14() -> void {
    u := crypto.uuid()
    test.assert_eq(u.substring(14, 15), "4")
}

// uuid variant nibble is 8/9/a/b at index 19
define test_uuid_variant_nibble_is_8_9_a_b_at_index() -> void {
    u := crypto.uuid()
    v := u.substring(19, 20)
    ok := false
    if v == "8" { ok = true }
    if v == "9" { ok = true }
    if v == "a" { ok = true }
    if v == "b" { ok = true }
    test.assert_true(ok)
}

// uuid differs across calls
define test_uuid_differs_across_calls() -> void {
    a := crypto.uuid()
    b := crypto.uuid()
    test.assert_ne(a, b)
}

