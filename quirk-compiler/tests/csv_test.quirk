use csv
use test

// ───── parse: basic ─────
// parse simple 2x2
define test_parse_simple_2x2() -> void {
    rows := csv.parse("a,b\nc,d")
    test.assert_eq(rows.length(), 2)
    r0: List = rows.get(0)
    r1: List = rows.get(1)
    test.assert_eq(r0.length(), 2)
    test.assert_eq(r1.length(), 2)
    test.assert_eq(r0.get(0), "a")
    test.assert_eq(r0.get(1), "b")
    test.assert_eq(r1.get(0), "c")
    test.assert_eq(r1.get(1), "d")
}

// parse handles trailing newline
define test_parse_handles_trailing_newline() -> void {
    rows := csv.parse("a,b\nc,d\n")
    test.assert_eq(rows.length(), 2)
}

// parse handles CRLF line endings
define test_parse_handles_crlf_line_endings() -> void {
    rows := csv.parse("a,b\r\nc,d")
    test.assert_eq(rows.length(), 2)
    r1: List = rows.get(1)
    test.assert_eq(r1.get(1), "d")
}

// parse empty input is empty list
define test_parse_empty_input_is_empty_list() -> void {
    rows := csv.parse("")
    test.assert_eq(rows.length(), 0)
}

// ───── parse: quoted fields ─────
// quoted field with embedded comma
define test_quoted_field_with_embedded_comma() -> void {
    rows := csv.parse("a,\"x,y\",c")
    r: List = rows.get(0)
    test.assert_eq(r.length(), 3)
    test.assert_eq(r.get(1), "x,y")
}

// quoted field with embedded newline
define test_quoted_field_with_embedded_newline() -> void {
    rows := csv.parse("\"line\nbreak\",b")
    test.assert_eq(rows.length(), 1)
    r: List = rows.get(0)
    test.assert_eq(r.get(0), "line\nbreak")
}

// escaped quote inside quoted field
define test_escaped_quote_inside_quoted_field() -> void {
    rows := csv.parse("\"a\"\"b\",c")
    r: List = rows.get(0)
    test.assert_eq(r.get(0), "a\"b")
}

// trailing empty field
define test_trailing_empty_field() -> void {
    rows := csv.parse("a,b,")
    r: List = rows.get(0)
    test.assert_eq(r.length(), 3)
    test.assert_eq(r.get(2), "")
}

// ───── parse_dicts ─────
// parse_dicts uses first row as keys
define test_parse_dicts_uses_first_row_as_keys() -> void {
    ds := csv.parse_dicts("name,age\nAlice,30\nBob,25")
    test.assert_eq(ds.length(), 2)
    d0: Map = ds.get(0)
    d1: Map = ds.get(1)
    test.assert_eq(d0.get("name"), "Alice")
    test.assert_eq(d0.get("age"), "30")
    test.assert_eq(d1.get("name"), "Bob")
}

// parse_dicts on empty header-only is empty
define test_parse_dicts_on_empty_header_only_is() -> void {
    ds := csv.parse_dicts("name,age")
    test.assert_eq(ds.length(), 0)
}

// ───── dump ─────
// dump basic
define test_dump_basic() -> void {
    text := csv.write([["a", "b"], ["c", "d"]])
    test.assert_eq(text, "a,b\r\nc,d")
}

// dump quotes fields with comma
define test_dump_quotes_fields_with_comma() -> void {
    text := csv.write([["a,b", "c"]])
    test.assert_eq(text, "\"a,b\",c")
}

// dump quotes fields with newline
define test_dump_quotes_fields_with_newline() -> void {
    text := csv.write([["a\nb", "c"]])
    test.assert_eq(text, "\"a\nb\",c")
}

// dump escapes internal quotes
define test_dump_escapes_internal_quotes() -> void {
    text := csv.write([["a\"b"]])
    test.assert_eq(text, "\"a\"\"b\"")
}

// dump preserves order in plain rows
define test_dump_preserves_order_in_plain_rows() -> void {
    text := csv.write([["1", "2"], ["3", "4"], ["5", "6"]])
    test.assert_eq(text, "1,2\r\n3,4\r\n5,6")
}

// ───── round-trip ─────
// parse(dump(rows)) is identity for simple data
define test_parse_dump_rows_is_identity_for_simple() -> void {
    original := [["name", "age"], ["Alice", "30"], ["Bob", "25"]]
    text := csv.write(original)
    rows := csv.parse(text)
    test.assert_eq(rows.length(), 3)
    r1: List = rows.get(1)
    test.assert_eq(r1.get(0), "Alice")
    test.assert_eq(r1.get(1), "30")
}

// round-trip preserves quoted contents
define test_round_trip_preserves_quoted_contents() -> void {
    original := [["with, comma", "with\"quote"]]
    text := csv.write(original)
    rows := csv.parse(text)
    r: List = rows.get(0)
    test.assert_eq(r.get(0), "with, comma")
    test.assert_eq(r.get(1), "with\"quote")
}

// ───── delimiter ─────
// custom tab delimiter
define test_custom_tab_delimiter() -> void {
    rows := csv.parse("a\tb\nc\td", "\t")
    r: List = rows.get(0)
    test.assert_eq(r.get(0), "a")
    test.assert_eq(r.get(1), "b")
}

