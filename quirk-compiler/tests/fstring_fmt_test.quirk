// Interpolation format specs — `${expr:fmt}` (Python style) and `${expr % fmt}`
// (Quirk's original) both work. The colon variant is the one most callers
// reach for; the `%`/`|` variants are still accepted for back-compat.

use test

// Double with `:.2f` rounds to 2 decimals
define test_float_precision() -> void {
    pi := 3.14159
    s := "${pi:.2f}"
    test.assert_eq(s, "3.14")
}

// Int with `:04d` zero-pads to width 4
define test_int_padded() -> void {
    n := 42
    s := "${n:04d}"
    test.assert_eq(s, "0042")
}

// Int with `:x` renders as lowercase hex
define test_int_hex() -> void {
    n := 255
    s := "${n:x}"
    test.assert_eq(s, "ff")
}

// legacy percent-separator still works
define test_legacy_percent() -> void {
    pi := 3.14159
    s := "${pi % .2f}"
    test.assert_eq(s, "3.14")
}

// no format spec leaves the value as-is
define test_plain_interp() -> void {
    n := 7
    s := "n=${n}"
    test.assert_eq(s, "n=7")
}

// `:` inside a slice stays inside the expr
define test_slice_in_interp() -> void {
    // The `:` between `1:3` is a slice separator, not a format spec —
    // the lexer tracks bracket depth so it only flips on a top-level `:`.
    arr := [10, 20, 30, 40]
    s := "got=${arr[1:3]}"
    test.assert_eq(s, "got=[20, 30]")
}

