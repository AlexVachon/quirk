// Round of small language extras: modulo `%`, hex/binary integer literals,
// triple-quoted strings, match guards, and tuple destructuring in match.
// `finally` was already implemented; the test for it lives in this file
// alongside the rest so a future regression on any of these is one run away.

use test

// ─── 1. Modulo `%` ────────────────────────────────────────────────
// `%` on Ints does remainder
define test_mod_basic() -> void {
    test.assert_eq(10 % 3, 1)
    test.assert_eq(20 % 5, 0)
    test.assert_eq(7 % 4, 3)
}

// `%=` compound-assigns the remainder back
define test_mod_assign() -> void {
    a := 100
    a %= 7
    test.assert_eq(a, 2)
}

// `%` works in an even/odd guard
define test_mod_evenodd() -> void {
    n := 17
    is_odd := n % 2 != 0
    test.assert_true(is_odd)
}

// ─── 2. Hex / binary integer literals ─────────────────────────────
// hex literals decode to the right decimal
define test_hex() -> void {
    test.assert_eq(0xFF, 255)
    test.assert_eq(0xCAFE, 51966)
    test.assert_eq(0x0, 0)
}

// binary literals decode to the right decimal
define test_bin() -> void {
    test.assert_eq(0b0, 0)
    test.assert_eq(0b1010, 10)
    test.assert_eq(0b11111111, 255)
}

// ─── 3. Triple-quoted strings ─────────────────────────────────────
// triple-quoted strings span multiple lines
define test_triple_basic() -> void {
    s := """line one
    line two
    line three"""
    test.assert_true(s.contains("line one"))
    test.assert_true(s.contains("line three"))
}

// interpolation works across newlines
define test_triple_interp() -> void {
    name := "Alice"
    s := """Hello, ${name}!
    Welcome."""
    test.assert_true(s.contains("Hello, Alice!"))
    test.assert_true(s.contains("Welcome."))
}

// ─── 4. Match guards ──────────────────────────────────────────────
// `case x if cond =>` runs only when guard is true
define test_guard_simple() -> void {
    n := 12
    result := ""
    match n {
        case x if x < 0 => result = "neg"
        case 0          => result = "zero"
        case x if x % 2 == 0 => result = "even"
        case _          => result = "odd"
    }
    test.assert_eq(result, "even")
}

// false guard falls through to next arm
define test_guard_falls_through() -> void {
    n := 3
    result := ""
    match n {
        case x if x % 2 == 0 => result = "even"
        case x if x > 0      => result = "positive odd"
        case _               => result = "other"
    }
    test.assert_eq(result, "positive odd")
}

// ─── 5. Tuple destructuring in match ──────────────────────────────
// `case (a, b) =>` binds tuple elements
define test_tuple_destruct() -> void {
    pair := (10, "hello")
    result := ""
    match pair {
        case (a, b) => result = "" + a + "/" + b
    }
    test.assert_eq(result, "10/hello")
}

// tuple destructure + guard cooperate
define test_tuple_destruct_guarded() -> void {
    point := (3, 3)
    result := ""
    match point {
        case (x, y) if x == y => result = "diagonal"
        case (x, y)           => result = "off-diagonal"
    }
    test.assert_eq(result, "diagonal")
}

// ─── 6. `finally` block (already shipped, regression coverage) ────
// finally runs after a caught exception
define test_finally_after_catch() -> void {
    log := List()
    try {
        log.append("try")
        throw Exception("boom")
    } catch (_e: Exception) {
        log.append("catch")
    } finally {
        log.append("finally")
    }
    test.assert_eq(log.length(), 3)
    test.assert_eq("" + log.get(2), "finally")
}

// finally runs when no exception was thrown
define test_finally_after_clean() -> void {
    log := List()
    try {
        log.append("try")
    } finally {
        log.append("finally")
    }
    test.assert_eq(log.length(), 2)
    test.assert_eq("" + log.get(1), "finally")
}

