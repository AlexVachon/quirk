// p110 — operators on two untyped values decide from the values (v7.8.0).
//
// Both sides untyped (List elements, Map values, a reduce accumulator):
// codegen decoded both as Ints and Sema typed the result Int, so
// [1.5, 2.5].sum() was 3, "a" + "b" from a List was 0 and ["b", "a"].min()
// compared garbage. Now `+` with a String concatenates, a Double on either
// side computes in floating point, otherwise checked Int math.
define main() -> void {
    xs := [1.5, 2.5]
    if xs[0] + xs[1] != 4.0          { print("FAIL: Double + Double"); return }
    if xs.sum() != 4.0               { print("FAIL: sum of Doubles"); return }
    if [1, 2, 3].sum() != 6          { print("FAIL: sum of Ints"); return }
    ws := ["a", "b"]
    if ws[0] + ws[1] != "ab"         { print("FAIL: String + String"); return }
    if ["b", "a", "c"].min() != "a"  { print("FAIL: min of Strings"); return }
    if [3.5, 1.25].max() != 3.5      { print("FAIL: max of Doubles"); return }
    m := {"x": 7, "y": 5}
    if m["x"] - m["y"] != 2          { print("FAIL: Map value arithmetic"); return }
    n: Int = [10, 3][0] / [10, 3][1]
    if n != 3                        { print("FAIL: Int division"); return }
    print("PASS: untyped operands")
}
