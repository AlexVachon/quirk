// p121 — Double text, collection ==, UTF-8 strings, literals, sort() (v7.9.0).
//
// - Doubles read the same everywhere, Python-style: print(1.5) printed
//   "1.500000" while "${1.5}" printed "1.5" (and %g dropped digits).
// - `==` compares List / Map / Set / Tuple contents; it compared identity.
// - String positions count characters: "héllo".length() was 6 (bytes).
// - Literals: `1_000` separators and `1e20` exponents.
// - `sort()` with no comparator sorts naturally (it was required).
define main() -> void {
    if 1.5.str() != "1.5" or "${4.0}" != "4.0" or (0.1 + 0.2).str() != "0.30000000000000004" {
        print("FAIL: Double text: " + 1.5.str() + " " + "${4.0}"); return
    }
    if 3.14159265.str() != "3.14159265" { print("FAIL: Double digits lost"); return }
    if [1.5, 2.0].str() != "[1.5, 2.0]" { print("FAIL: Double in a List"); return }
    if not ([1, 2] == [1, 2]) or [1, 2] == [2, 1] { print("FAIL: List =="); return }
    if not ({"a": [1]} == {"a": [1]})            { print("FAIL: nested Map =="); return }
    if not ([1] in [[1], [2]])                    { print("FAIL: in by value"); return }
    s := "héllo"
    if s.length() != 5 or s[1] != "é" or s.reverse() != "olléh" { print("FAIL: UTF-8 length/index/reverse"); return }
    if s.substring(1, 3) != "él" or s.find("llo") != 2           { print("FAIL: UTF-8 substring/find"); return }
    if "[${s:>7}]" != "[  héllo]"                                 { print("FAIL: UTF-8 width: [${s:>7}]"); return }
    n := 0
    for c in "日本" { n = n + 1 }
    if n != 2 { print("FAIL: UTF-8 iteration"); return }
    if 1_000_000 != 1000000 or 0xFF_FF != 65535  { print("FAIL: _ separators"); return }
    if 1e3 != 1000.0 or 2.5e-3 != 0.0025         { print("FAIL: exponent literals"); return }
    if [3, 1, 2].sort().str() != "[1, 2, 3]"        { print("FAIL: sort()"); return }
    if ["b", "c", "a"].sort().str() != "[a, b, c]"  { print("FAIL: sort() Strings"); return }
    if [1, 3, 2].sort(fn(a, b) => b - a).str() != "[3, 2, 1]" { print("FAIL: sort(cmp)"); return }
    print("PASS: doubles, ==, UTF-8, literals, sort")
}
