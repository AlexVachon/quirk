// p135 — three v7.20.0 fixes:
//  1. `module.Type` in an annotation — `p: process.Process`,
//     `-> process.RunResult`, `catch (e: process.ProcessError)` — names
//     the struct. A parameter typed that way was silently untyped; a
//     return type or catch type didn't parse.
//  2. A method called on an untyped value with some arguments left to
//     their defaults (`x.communicate()`) dispatches; it was rejected as
//     "no type has a method ... with 0 arguments".
//  3. `print(v)` where `v` is a struct-typed null prints "null" instead
//     of crashing in its __str.
use process

define fail(msg: String) -> void { print("FAIL: " + msg) }

define finish(p: process.Process) -> process.RunResult {
    return p.communicate(input="hi")
}

define untyped_finish(p: Any) -> String {
    r := p.communicate()
    return r.stdout
}

struct Box {
    v: Int
    define __init(self, v: Int) -> void { self.v = v }
    define __str(self) -> String { return "Box(" + self.v.str() + ")" }
}

define maybe(ok: Bool) -> Box {
    if ok { return Box(1) }
    return null
}

define main() -> void {
    r := finish(process.spawn(["cat"]))
    if r.stdout != "hi" { fail("qualified param / return type: " + r.stdout) }
    if not r.ok { fail("RunResult fields through a qualified return type") }

    out := untyped_finish(process.spawn(["echo", "x"], stdin="null"))
    if out != "x\n" { fail("untyped call with defaults: '" + out + "'") }

    caught := ""
    try {
        process.run(["false"], check=true)
    } catch (e: process.ProcessError) {
        caught = e.message
    }
    if not caught.contains("exited with code 1") { fail("qualified catch type: " + caught) }
    anon := false
    try {
        process.output(["false"])
    } catch (process.ProcessError) {
        anon = true
    }
    if not anon { fail("qualified anonymous catch") }

    print(maybe(true))
    print(maybe(false))
    print("ok")
}
