// A lambda's captures missed names that appeared only inside a map
// literal, ternary, slice, comprehension, range, constructor argument or
// `with` — e.g. `fn(req, res) { res.render("p.html", {"notes": notes}) }`
// read an unbound `notes` (a compiler crash).
define fail(msg: String) -> void { print("FAIL: " + msg) }

define call(f: Callable) -> Any {
    return f(0)
}

define main() -> void {
    notes := ["a", "b"]
    flag := true
    word := "hello"
    n := 3
    m: Map = call(fn(x) { return {"notes": notes} })
    if String(m) != "{\"notes\": [a, b]}" { fail("map literal: " + String(m)) }
    t := call(fn(x) { return flag ? "yes" : "no" })
    if String(t) != "yes" { fail("ternary: " + String(t)) }
    s := call(fn(x) { return word[1:3] })
    if String(s) != "el" { fail("slice: " + String(s)) }
    c: List = call(fn(x) { return [v * n for v in [1, 2]] })
    if String(c) != "[3, 6]" { fail("comprehension: " + String(c)) }
}
