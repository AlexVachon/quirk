// crypto's password hashing (scrypt, in the runtime: Crypto_hash_password /
// verify_password / needs_rehash) and constant-time equal.
use crypto

define fail(msg: String) -> void { print("FAIL: " + msg) }

define main() -> void {
    h := crypto.hash_password("s3cret")
    if not h.startswith(r"$scrypt$ln=15,r=8,p=3$") { fail("format: " + h) }
    if not crypto.verify_password("s3cret", h) { fail("the right password") }
    if crypto.verify_password("s3cres", h) { fail("a wrong password") }
    if crypto.verify_password("s3cret", "not a hash") { fail("not a hash") }
    if crypto.needs_rehash(h) or not crypto.needs_rehash(h.replace("ln=15", "ln=14")) { fail("needs_rehash") }
    if h == crypto.hash_password("s3cret") { fail("the same salt twice") }
    if not crypto.equal("abc", "abc") or crypto.equal("abc", "abd") or crypto.equal("ab", "abc") { fail("equal") }
    if crypto.random_hex(8).length() != 16 { fail("random_hex") }
    print("ok")
}
