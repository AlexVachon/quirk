// expect-error: Q0209
// p49 — Double → Int field assign (v3.0.3, surfaced by tools/fuzz.py
// @ seed=7).
//
// v3.0.3 fixed an ICE here: the field-assign Codegen had no
// `double → i64` path, so `self.age = a` stored a double into an Int
// field and LLVM's verifier crashed. It then truncated silently via
// FPToSI — but only for fields: `x: Int = 2.7` kept a Double and
// `n = 4.2` stored the Double's bits as an Int. Since v7.0.1 every
// assignment is type-checked and Double → Int must be explicit
// (`a.to_int()` / `a as Int`), the same rule as Int parameters.

struct Profile {
    name: String
    age: Int

    define __init(self, n: String, a: Double) -> void {
        self.name = n
        self.age = a            // Q0209: Double → Int field
    }
}

define main() -> void {
    p := Profile("Alice", 27.6)
    if p.age != 27 { print("FAIL: age expected 27, got ${p.age}"); return }
    if p.name != "Alice" { print("FAIL: name"); return }
    print("PASS: Double → Int field-assign coerces via FPToSI")
}
