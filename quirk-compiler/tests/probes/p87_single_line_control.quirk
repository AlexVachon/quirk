// p87 — `=>` single-statement body works on every control-flow
// construct (v5.3.0). Same shape users already know from lambdas
// (`fn(x) => x * 2`) and match arms (`case Some => body`).
//
// Braced form and `=>` form are freely mixable within the same
// program — this probe exercises the parser transition points
// (each block enters via `=>` and exits back to normal statement
// parsing).

x := -5
if x < 0 => x = -x
print(x)                            // 5

// if / elif / else with all three single-statement bodies.
kind := 2
if kind == 1      => print("one")
elif kind == 2    => print("two")
else              => print("many")   // "two"

// while single-statement.
i := 0
while i < 3 => i = i + 1
print(i)                            // 3

// for single-statement.
total := 0
for n in [10, 20, 30] => total = total + n
print(total)                        // 60

// Braced form still works alongside.
for n in [1, 2, 3] {
    if n == 2 => continue
    print(n)                        // 1, then 3
}
