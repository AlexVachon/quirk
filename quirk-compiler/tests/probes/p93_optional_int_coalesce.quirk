// p93 — `??` with a primitive fallback (v5.3.11). `x ?? 0` with
// `x: Int?` used to drop the fallback entirely: Codegen replaced a
// non-pointer RHS with null, so a null LHS printed "null" and
// `n: Int := x ?? 7` read 0. Now the LHS is unboxed and selected
// natively against the Int/Float fallback.
//
// Expected output:
//   0
//   42
//   8
//   -1
//   3
//   1.500000
define pick(v: Int?) -> Int {
    return v ?? -1
}

define main() -> void {
    x: Int? = null
    y: Int? = 42
    print(x ?? 0)
    print(y ?? 0)
    n: Int := x ?? 7
    print(n + 1)
    print(pick(null))
    print(pick(3))
    d: Float? = null
    print(d ?? 1.5)
}
