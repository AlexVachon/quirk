use url
use test

// ───── quote / unquote round-trips ─────
// quote leaves unreserved chars
define test_quote_leaves_unreserved_chars() -> void {
    test.assert_eq(url.quote("ABCxyz0-9_.~"), "ABCxyz0-9_.~")
}

// quote escapes space
define test_quote_escapes_space() -> void {
    test.assert_eq(url.quote("a b"), "a%20b")
}

// quote escapes punctuation
define test_quote_escapes_punctuation() -> void {
    test.assert_eq(url.quote("a&b=c"), "a%26b%3Dc")
}

// unquote inverts quote
define test_unquote_inverts_quote() -> void {
    s := "Hello, world! /a?b=c#d"
    test.assert_eq(url.unquote(url.quote(s)), s)
}

// unquote handles raw % at end
define test_unquote_handles_raw_at_end() -> void {
    // Trailing "%" with no two hex digits should pass through.
    test.assert_eq(url.unquote("100%"), "100%")
}

// unquote_form maps + to space
define test_unquote_form_maps_to_space() -> void {
    test.assert_eq(url.unquote_form("a+b%20c"), "a b c")
}

// ───── parse: full URL ─────
// parse full URL with all components
define test_parse_full_url_with_all_components() -> void {
    u := url.parse("https://api.example.com:8443/v1/users?id=42#bio")
    test.assert_eq(u.scheme, "https")
    test.assert_eq(u.host, "api.example.com")
    test.assert_eq(u.port, 8443)
    test.assert_eq(u.path, "/v1/users")
    test.assert_eq(u.query, "id=42")
    test.assert_eq(u.fragment, "bio")
}

// parse URL without port
define test_parse_url_without_port() -> void {
    u := url.parse("http://example.com/path")
    test.assert_eq(u.host, "example.com")
    test.assert_eq(u.port, 0)
    test.assert_eq(u.path, "/path")
}

// parse URL without path
define test_parse_url_without_path() -> void {
    u := url.parse("https://example.com")
    test.assert_eq(u.host, "example.com")
    test.assert_eq(u.path, "")
}

// parse URL with query but no fragment
define test_parse_url_with_query_but_no_fragment() -> void {
    u := url.parse("http://x.com/a?b=c")
    test.assert_eq(u.query, "b=c")
    test.assert_eq(u.fragment, "")
}

// parse URL with fragment but no query
define test_parse_url_with_fragment_but_no_query() -> void {
    u := url.parse("http://x.com/a#top")
    test.assert_eq(u.query, "")
    test.assert_eq(u.fragment, "top")
}

// parse URL with multiple ? in fragment is ok
define test_parse_url_with_multiple_in_fragment_is() -> void {
    u := url.parse("http://x.com/a?q=1#sec?nested")
    test.assert_eq(u.query, "q=1")
    test.assert_eq(u.fragment, "sec?nested")
}

// ───── recomposition ─────
// to_string round-trips a full URL
define test_to_string_round_trips_a_full_url() -> void {
    s := "https://api.example.com:8443/v1/users?id=42#bio"
    test.assert_eq(url.parse(s).to_string(), s)
}

// to_string round-trips a minimal URL
define test_to_string_round_trips_a_minimal_url() -> void {
    s := "http://example.com/x"
    test.assert_eq(url.parse(s).to_string(), s)
}

// ───── parse_query ─────
// parse_query decodes percent-escapes
define test_parse_query_decodes_percent_escapes() -> void {
    q := url.parse_query("name=Alice%20Smith&age=30")
    test.assert_eq(q.get("name"), "Alice Smith")
    test.assert_eq(q.get("age"), "30")
}

// parse_query handles bare key (no =)
define test_parse_query_handles_bare_key_no() -> void {
    q := url.parse_query("flag&n=1")
    test.assert_eq(q.get("flag"), "")
    test.assert_eq(q.get("n"), "1")
}

// parse_query strips leading ?
define test_parse_query_strips_leading() -> void {
    q := url.parse_query("?a=1")
    test.assert_eq(q.get("a"), "1")
}

// ───── build_query ─────
// build_query encodes values
define test_build_query_encodes_values() -> void {
    m := Map()
    m.put("q", "hello world")
    test.assert_eq(url.build_query(m), "q=hello%20world")
}

