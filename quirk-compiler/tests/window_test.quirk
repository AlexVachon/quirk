// window v1.0.0, headless (SDL's dummy video driver — no display needed).
// Needs SDL2 installed; every test is skipped (passes) when it isn't.
use window
use fs
use test

bg := window.rgb(10, 20, 30)

define open(title: String, width: Int, height: Int) -> window.Window {
    return window.open(title, width, height, headless=true)
}

// ───── colours ─────
define test_colours() -> void {
    test.assert_eq(window.rgb(255, 136, 0), window.hex("#ff8800"))
    test.assert_eq(window.hex("#f80"), window.hex("ff8800"))
    test.assert_eq(window.channels(window.rgba(1, 2, 3, 4)), [1, 2, 3, 4])
    test.assert_eq(window.channels(window.hex("#11223380")), [17, 34, 51, 128])
    test.assert_eq(window.channels(window.rgb(300, -5, 7)), [255, 0, 7, 255])
    caught := false
    try {
        window.hex("nope")
    } catch (ValueError) {
        caught = true
    }
    test.assert_true(caught)
}

define test_text_width() -> void {
    test.assert_eq(window.text_width("abc"), 24)
    test.assert_eq(window.text_width("abc", 2), 48)
    test.assert_eq(window.text_width("ab\nlonger"), 48)
    test.assert_eq(window.text_width("é"), 8)
}

// ───── drawing ─────
define test_open_and_size() -> void {
    if not window.available() { return }
    w := open("size", 120, 80)
    test.assert_true(w.is_open())
    test.assert_eq(w.width(), 120)
    test.assert_eq(w.height(), 80)
    test.assert_eq(w.str(), "Window(\"size\", 120x80)")
    w.close()
    test.assert_false(w.is_open())
}

define test_shapes() -> void {
    if not window.available() { return }
    w := open("shapes", 200, 100)
    w.clear(bg)
    w.rect(10, 10, 20, 20, window.rgb(255, 0, 0))
    w.rect(50, 10, 20, 20, window.rgb(0, 0, 255), fill=false)
    w.circle(100, 50, 10, window.rgb(0, 255, 0))
    w.line(0, 99, 199, 99, window.white())
    w.point(199, 0, window.rgb(1, 2, 3))
    test.assert_eq(w.pixel(0, 0), 0x0a141e)
    test.assert_eq(w.pixel(15, 15), 0xff0000)
    test.assert_eq(w.pixel(50, 15), 0x0000ff)
    test.assert_eq(w.pixel(60, 20), 0x0a141e)
    test.assert_eq(w.pixel(100, 50), 0x00ff00)
    test.assert_eq(w.pixel(100, 41), 0x00ff00)
    test.assert_eq(w.pixel(100, 38), 0x0a141e)
    test.assert_eq(w.pixel(120, 99), 0xffffff)
    test.assert_eq(w.pixel(199, 0), 0x010203)
    w.close()
}

define test_transparency_blends() -> void {
    if not window.available() { return }
    w := open("alpha", 20, 20)
    w.clear(window.rgb(0, 0, 0))
    w.rect(0, 0, 20, 20, window.rgba(255, 255, 255, 128))
    c := window.channels(w.pixel(5, 5))
    test.assert_true(c[0] > 100 and c[0] < 160)
    w.close()
}

define test_text_draws_in_its_cell() -> void {
    if not window.available() { return }
    w := open("text", 100, 40)
    w.clear(bg)
    test.assert_eq(w.text("Hi", 10, 10, window.rgb(0, 0, 255)), 16)
    inside := 0
    outside := 0
    for y in 0..40 {
        for x in 0..100 {
            if w.pixel(x, y) == 0x0000ff {
                if x >= 10 and x < 26 and y >= 10 and y < 26 { inside = inside + 1 } else { outside = outside + 1 }
            }
        }
    }
    test.assert_true(inside > 20)
    test.assert_eq(outside, 0)
    w.close()
}

define test_two_windows_are_separate() -> void {
    if not window.available() { return }
    a := open("a", 30, 30)
    b := open("b", 30, 30)
    a.clear(window.rgb(255, 0, 0))
    b.clear(window.rgb(0, 255, 0))
    test.assert_eq(a.pixel(5, 5), 0xff0000)
    test.assert_eq(b.pixel(5, 5), 0x00ff00)
    b.close()
    test.assert_true(a.is_open())
    a.close()
}

define test_screenshot_and_image() -> void {
    if not window.available() { return }
    dir := fs.temp_dir()
    w := open("shot", 40, 30)
    w.clear(window.rgb(0, 128, 255))
    w.rect(0, 0, 10, 10, window.yellow())
    path := fs.join(dir, "shot.bmp")
    w.screenshot(path)
    test.assert_true(fs.size(path) > 40 * 30 * 3)
    img := w.load_image(path)
    test.assert_eq(img.width, 40)
    test.assert_eq(img.height, 30)
    w.clear(window.black())
    w.image(img, 0, 0)
    test.assert_eq(w.pixel(20, 20), 0x0080ff)
    test.assert_eq(w.pixel(5, 5), window.channels(window.yellow())[0] * 65536 + window.channels(window.yellow())[1] * 256 + window.channels(window.yellow())[2])
    w.image(img, 0, 0, 80, 60)
    img.free()
    w.close()
    fs.remove_tree(dir)
}

define test_load_missing_image_throws() -> void {
    if not window.available() { return }
    w := open("img", 10, 10)
    caught := ""
    try {
        w.load_image("/nonexistent/x.bmp")
    } catch (e: window.WindowError) {
        caught = e.message
    }
    test.assert_contains(caught, "/nonexistent/x.bmp")
    w.close()
}

// ───── events / loop ─────
define test_events_and_wait() -> void {
    if not window.available() { return }
    w := open("events", 10, 10)
    // Drain the startup events (focus...), which can arrive a little late.
    tries := 0
    while w.wait_event(50) != null and tries < 20 { tries = tries + 1 }
    t0 := window.ticks()
    e := w.wait_event(50)
    test.assert_true(e == null)
    test.assert_true(window.ticks() - t0 >= 40)
    w.close()
    test.assert_eq(w.events().length(), 0)
}

frames := 0

define _frame(w: window.Window, events: List) -> void {
    frames = frames + 1
    w.clear(window.blue())
    w.circle(5, 5, 3, window.white())
    if frames == 5 { w.close() }
}

define test_run_calls_frame_until_closed() -> void {
    if not window.available() { return }
    frames = 0
    w := open("run", 20, 20)
    t0 := window.ticks()
    window.run(w, _frame, fps=100)
    test.assert_eq(frames, 5)
    test.assert_false(w.is_open())
    test.assert_true(window.ticks() - t0 >= 30)
}

define test_sleep() -> void {
    t0 := window.ticks()
    window.sleep(30)
    test.assert_true(window.ticks() - t0 >= 29)
}

// ───── image formats (tests/fixtures/images) ─────
images := "tests/fixtures/images/"

define test_png_with_transparency() -> void {
    if not window.available() { return }
    w := open("png", 20, 20)
    img := w.load_image(images + "rgba.png")
    test.assert_eq(img.width, 4)
    test.assert_eq(img.height, 4)
    w.clear(window.rgb(10, 20, 30))
    w.image(img, 0, 0)
    test.assert_eq(w.pixel(0, 0), 0xff0000)
    test.assert_eq(w.pixel(1, 1), 0x00ff00)
    test.assert_eq(w.pixel(2, 2), 0x0000ff)
    test.assert_eq(w.pixel(0, 3), 0xffffff)
    test.assert_eq(w.pixel(3, 0), 0x0a141e)          // transparent column shows the background
    w.image(img, 10, 10, width=8, height=8)          // scaled 2x
    test.assert_eq(w.pixel(11, 13), 0x00ff00)
    w.close()
}

define test_jpeg_and_gif() -> void {
    if not window.available() { return }
    w := open("jpg", 20, 20)
    jpg := w.load_image(images + "solid.jpg")
    test.assert_eq(jpg.width, 8)
    w.image(jpg, 0, 0)
    c := window.channels(w.pixel(4, 4))
    test.assert_true(c[0] > 190 and c[0] < 210 and c[1] > 90 and c[1] < 110 and c[2] > 40 and c[2] < 60)
    gif := w.load_image(images + "checker.gif")
    w.image(gif, 10, 10)
    test.assert_eq(w.pixel(10, 10), 0xff0000)
    test.assert_eq(w.pixel(11, 10), 0x0000ff)
    w.close()
}

define test_sprite_sheet_region_and_alpha() -> void {
    if not window.available() { return }
    w := open("sheet", 40, 20)
    sheet := w.load_image(images + "sheet.png")
    test.assert_eq(sheet.width, 64)
    w.clear(window.black())
    w.image(sheet, 0, 0, src_x=32, src_w=16, src_h=16)   // third frame: blue
    test.assert_eq(w.pixel(8, 8), 0x0000ff)
    test.assert_eq(w.pixel(20, 8), 0x000000)              // only 16px drawn
    w.image(sheet, 20, 0, src_x=48)                        // last frame to the edge
    test.assert_eq(w.pixel(30, 8), 0xffff00)
    w.clear(window.black())
    w.image(sheet, 0, 0, src_w=16, alpha=128)              // half-transparent red
    c := window.channels(w.pixel(4, 4))
    test.assert_true(c[0] > 110 and c[0] < 140)
    w.close()
}

define test_bad_image_file_throws() -> void {
    if not window.available() { return }
    w := open("bad", 10, 10)
    caught := ""
    try {
        w.load_image(images + "not_an_image.png")
    } catch (e: window.WindowError) {
        caught = e.message
    }
    test.assert_contains(caught, "not an image")
    w.close()
}
